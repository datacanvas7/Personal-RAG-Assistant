# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# Variables for later phases (LLM and embedding providers, chunking, ...) are added to
# this file in the phase that introduces them.

# --- General ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (+ pgvector) -----------------------------------------------------------
POSTGRES_DB=rag
POSTGRES_USER=rag
# Development placeholder. Use a long random value anywhere beyond your own machine:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-in-real-deployments

# --- Redis / Celery (container addresses; Compose service names) -----------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS ------------------------------------------------------------------------------
# Leave empty: the browser reaches the API through the frontend's /api/v1 proxy, which is
# same-origin. Only set this (comma-separated) if a browser app on another origin calls
# the API directly.
BACKEND_CORS_ORIGINS=

# --- Authentication --------------------------------------------------------------------
# Signs access tokens. Must be at least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everybody out. The API refuses to start in production with the
# placeholder below.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Seconds during which a just-rotated refresh token is refused without revoking the
# session (two browser tabs refreshing at once). Replays after that revoke the session.
REFRESH_REUSE_GRACE_SECONDS=10
# Send the refresh cookie over HTTPS only. Leave false for http://localhost; MUST be
# true behind HTTPS (the API refuses to start in production otherwise).
COOKIE_SECURE=false

# --- Document ingestion ----------------------------------------------------------------
# Largest accepted upload, in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
# Chunk size and same-page overlap, in characters. Overlap may be at most half the size.
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# --- Embeddings ------------------------------------------------------------------------
# Vector size stored in the database. Fixed by the embedding model chosen later
# (all-MiniLM-L6-v2 = 384). Changing it needs a migration and re-indexing.
EMBEDDING_DIMENSION=384
