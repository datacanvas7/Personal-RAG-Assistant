# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# Variables for later phases (LLM and embedding providers, chunking, ...) are added to
# this file in the phase that introduces them.

# --- General ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (+ pgvector) -----------------------------------------------------------
POSTGRES_DB=rag
POSTGRES_USER=rag
# Development placeholder. Use a long random value anywhere beyond your own machine:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me-in-real-deployments

# --- Redis / Celery (container addresses; Compose service names) -----------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS ------------------------------------------------------------------------------
# Leave empty: the browser reaches the API through the frontend's /api/v1 proxy, which is
# same-origin. Only set this (comma-separated) if a browser app on another origin calls
# the API directly.
BACKEND_CORS_ORIGINS=

# --- Authentication --------------------------------------------------------------------
# Signs access tokens. Must be at least 32 characters. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everybody out. The API refuses to start in production with the
# placeholder below.
JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Seconds during which a just-rotated refresh token is refused without revoking the
# session (two browser tabs refreshing at once). Replays after that revoke the session.
REFRESH_REUSE_GRACE_SECONDS=10
# Send the refresh cookie over HTTPS only. Leave false for http://localhost; MUST be
# true behind HTTPS (the API refuses to start in production otherwise).
COOKIE_SECURE=false

# --- Document ingestion ----------------------------------------------------------------
# Largest accepted upload, in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
# Chunk size and same-page overlap, in characters. Overlap may be at most half the size.
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# --- Embeddings ------------------------------------------------------------------------
# Default: a local model (BAAI/bge-small-en-v1.5). No API key, nothing leaves your machine;
# the first start downloads ~130 MB into the `models` volume.
EMBEDDING_PROVIDER=sentence_transformers
# Leave empty for the provider's default (bge-small-en-v1.5 / text-embedding-3-small).
EMBEDDING_MODEL=
# Vector size stored in the database. Changing it needs a migration and a re-index.
# 384 fits bge-small; text-embedding-3-* are shortened to this size by the API.
EMBEDDING_DIMENSION=384
# BGE instruction prepended to *search queries* (not documents). Defaults to BGE's own;
# only set this (an empty value disables it) if you switch to a model that needs another.
# EMBEDDING_QUERY_PREFIX=
EMBEDDING_BATCH_SIZE=32

# Hosted alternative: EMBEDDING_PROVIDER=openai. Document text is then sent to OpenAI.
# Switching providers changes the vectors: run `python -m app.scripts.reindex` afterwards
# (the API refuses to start until you do). With the hosted provider you can also build the
# image without the local model: INSTALL_LOCAL_EMBEDDINGS=false.
OPENAI_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
INSTALL_LOCAL_EMBEDDINGS=true

# --- Language model (answers) ------------------------------------------------------------
# Any OpenAI-compatible endpoint. Defaults target Google Gemini, which has a free tier:
# create a key at https://aistudio.google.com/apikey and paste it below. Never commit it.
# Without a key everything else works; only POST /ask answers with 503.
# Gemini retires models regularly: `python -m app.scripts.check_llm` lists what your key can
# use right now. Other providers: set LLM_BASE_URL/LLM_MODEL (e.g. Groq, OpenRouter, OpenAI,
# or Ollama at http://host.docker.internal:11434/v1 with any non-empty LLM_API_KEY).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Optional, passed through as reasoning_effort (e.g. low). Empty = the model's default.
LLM_REASONING_EFFORT=

# --- Retrieval and answering -------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Passages scoring below this cosine similarity are ignored; if none remain, the answer is
# "not found" without calling the model. A starting value, tuned in Phase 11.
RETRIEVAL_SCORE_THRESHOLD=0.45
MAX_CONTEXT_CHARS=12000
CHAT_HISTORY_MAX_MESSAGES=6
